# StockLabs backend — environment contract.
#
# Copy to `.env` for local development, or to `.env.prod` on the VM for the
# compose stack. Neither is ever committed, and neither is ever baked into the
# image (see .dockerignore) — the running containers get these via compose.
#
# Generate every secret with:  openssl rand -hex 32
# Hex specifically, not base64: compose interpolates `$` in .env values, and
# `@ : / ?` inside a password must be percent-encoded to survive a DSN. A
# password containing any of those fails in a way that looks like a network
# problem.

# ─── Required. The process refuses to boot without these. ────────────────────

# Signing keys. MUST differ from each other. Regenerate for the new deployment:
# the database starts empty, so tokens minted against the old one reference user
# IDs that no longer exist.
JWT_SECRET=
JWT_REFRESH_SECRET=

# In compose this points at the internal postgres service, which is not
# reachable from outside the VM.
#
# connection_limit is not optional at scale: Prisma's default pool is
# (cpus * 2 + 1) PER PROCESS, so N api replicas plus the worker will exhaust
# Postgres's default max_connections=100 without it. Budget
# (replicas x limit) + worker + backups well under that.
DATABASE_URL=postgresql://app:CHANGEME@postgres:5432/stocklabs?schema=public&connection_limit=5&pool_timeout=10&connect_timeout=5

# ─── Role. Set per service by compose; leave unset locally. ──────────────────
#
#   api    — HTTP + Socket.IO. Scalable to N replicas.
#   worker — Binance feed, commodity feed, midnight cron. ALWAYS exactly 1.
#   unset  — both, which is what a single local process has always been.
#
# An unrecognised value throws at boot rather than falling back, because a
# typo'd ROLE silently becoming "all" would put an ingester and a cron into
# every api replica.
# ROLE=api

# ─── Infrastructure ──────────────────────────────────────────────────────────

# The compose service name. Required whenever NODE_ENV is not DEVELOPMENT:
# inside a container the old 127.0.0.1 fallback resolves to the container's own
# namespace, so the process boots fine and then fails at everything.
# No TLS needed — this never leaves the internal network.
REDIS_URL=redis://redis:6379

# `production` flips cookies to secure:true + sameSite:none, which REQUIRES TLS
# terminating in front. Over plain HTTP the browser silently drops the session
# cookie and every web login fails as a 401 loop with no error anywhere.
NODE_ENV=production

PORT=4000

# ─── Application ─────────────────────────────────────────────────────────────

# Comma-separated browser origins allowed to send credentialed requests.
# Was hardcoded in app.ts; a new deployment domain used to need a rebuild.
# Note: Socket.IO CORS stays permissive on purpose — the Expo app sends no
# Origin header, and an allow-list there breaks mobile entirely.
CORS_ORIGINS=https://stocklabs.aryantechie.in

# One additional allowed origin, appended to CORS_ORIGINS. Point it at a staging
# frontend, or at http://localhost:3000 when testing a local web app against
# this backend.
CLIENT_URL=https://stocklabs.aryantechie.in

# Session cookie lifetime, in days.
COOKIE_EXPIRY=3

# Transactional email. Without it the server boots with a warning and password
# reset silently no-ops — a broken reset flow whose only symptom is a log line.
RESEND_API_KEY=

# ─── Deliberately unset in production ────────────────────────────────────────

# API_URL enabled a 12-minute self-ping that existed only to stop a free-tier
# host idling out. On a VM it is pure noise: every replica would drive traffic
# back through nginx and into the rate-limit counters.
# API_URL=

# Binance stream host. Promoted from a hardcoded constant so a geo-restricted
# egress IP — the failure that silently killed the futures endpoint, handshake
# fine and zero messages forever — is a config change rather than a rebuild.
# Fallback if the default is blocked from the VM: wss://data-stream.binance.vision
# BINANCE_WS_BASE=wss://stream.binance.com:9443

# ─── Compose-only (not read by the app) ──────────────────────────────────────

POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=stocklabs

# Certificate issuance, read by docker/scripts/init-letsencrypt.sh.
# ACME_DOMAIN must also match `server_name` and the ssl_certificate paths in
# docker/nginx/nginx.conf — three places, one name.
ACME_DOMAIN=api.example.com
ACME_EMAIL=you@example.com

# Days of pg_dump files to keep. Read by docker/scripts/backup.sh.
BACKUP_RETENTION_DAYS=14
